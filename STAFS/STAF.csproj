<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>STAF.UI.API</PackageId>
    <Authors>Sooraj Ramachandran</Authors>
    <Product>STAF</Product>
    <Description>A Test Automation Framework for CSharp Selenium-based UI and API testing, featuring built-in reporting capabilities with MCP Agent Support.</Description>
    <Copyright></Copyright>
    <AssemblyName>STAF</AssemblyName>
    <RootNamespace>STAF</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Selenium, Framework, API, UI Tests, API Tests, Excel</PackageTags>
    <PackageReleaseNotes>This release targets .NET 10. Underlying projects consuming STAF.UI.API must use .NET 10 or above.
Updates dependencies to Selenium 4.49, MSTest 4.4.1, Microsoft.Data.SqlClient 7.1.0, Deque.AxeCore.Selenium 4.13.0, and Microsoft.Extensions.Configuration.Json 10.0.12.
Test projects that pin an older MSTest.TestFramework or MSTest.TestAdapter should move both to 4.4.1 or later.
UI and API test framework for Selenium.
Supports Chrome, Edge &amp; Remote Drivers.
Supports Parallel execution and is thread safe.
Click the repository link to setup and get started quickly with a sample project.
https://github.com/sooraj171/STAF.Selenium.Tests
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/STAF.Selenium.Tests</RepositoryUrl>
    <PackageIcon>staf.png</PackageIcon>
    <PackageIconUrl />
    <Version>4.4.4</Version>
    <AssemblyVersion>4.4.4.0</AssemblyVersion>
    <FileVersion>4.4.4.0</FileVersion>
    <RepositoryType />
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PackageOutputPath>$(MSBuildProjectDirectory)\bin\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="test - Copy11.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Deque.AxeCore.Selenium" Version="4.13.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="Selenium.Support" Version="4.49.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.49.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="staf.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
